# schedules

_reg_aaa() {
    _lcl_vcs_x
}
_reg_aab()
{
    prnt "backup '''essentials'''"
    _lca_vcs_a
    _rma_rst_min
    _notif
}

main()
{
    cmd="${1}" && shift 1
    ini
    case ${cmd} in
        tga)      _reg_aaa ;;
        tgb)      _reg_aab ;;
        laa)      _lcl_vcs_aaa ;;
        raa)      _rem_par_min ;;
        # local/remote selectors
        rma)      _rem_raa ;;
        lca)      _lcl_laa ;;
        # dependent on device plugs
        dva)      _dva_a ;;
        dvb)      _dvb_a ;;
        dvc)      _dvc_a ;;
        dvx)      _dvx_a ;;
        # maintenance
        pre)      _bk_sys_ini ;;
        notif)    notif ;;
        *)        $(@) ;;
    esac
}
main "${@}"
