ini()
{
    [ -f ${BHQC} ] \
        || { echo "missing bhq config; exiting"; exit; }
    source ${BHQC}
    _env_bhq
    _notif_env
}

prnt()  { printf "BHQ: %s\n" "#" "$1"; }
prntx() { printf "BHQ: %s\n" "$1"; }
notif() { notify-send -u low "${lineh}" "${linex}"; }

_bk_sys_ini()
{
    _bk_sys_pre
}

# bksq

_lcb_sys()      { _bk_sys_ini;  }
_rma_rst_min()  { yes | rst gcs bpmin; } # remote part min

